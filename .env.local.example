# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.

# Your dev machine's LAN IP address (not localhost).
# localhost resolves to the device itself on physical hardware,
# not to your dev machine. Find your LAN IP with:
#   macOS: System Settings → Wi-Fi → Details → IP Address
#   or run: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

EXPO_PUBLIC_APP_ENV=local
